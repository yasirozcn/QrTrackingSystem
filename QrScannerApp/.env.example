# Kopyalayın: cp .env.example .env   (.env git'e girmez)
# Telefonun bağlanacağı AdminPanel adresi = bilgisayarınızın yerel IP'si (ipconfig getifaddr en0) + :3000.
# Telefon ve bilgisayar aynı Wi-Fi'da olmalı. Veritabanına telefon değil, AdminPanel bağlanır.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
